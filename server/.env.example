# ---- EverCare server configuration -------------------------------------
EVERCARE_BIND=0.0.0.0:8080

# Upstream model provider. Anything OpenAI-compatible works (DeepSeek, OpenAI,
# Moonshot, a local vLLM/Ollama gateway ...).
EVERCARE_UPSTREAM_BASE_URL=https://api.deepseek.com
EVERCARE_UPSTREAM_API_KEY=sk-replace-me
EVERCARE_UPSTREAM_MODEL=deepseek-chat

# Where device/subscription records are persisted (JSON file).
EVERCARE_DATA_FILE=./evercare-data.json

# Grant every newly registered device a free trial of this many days.
EVERCARE_TRIAL_DAYS=7
